{
  "name": "voice-saas-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "npm --workspace=apps/api test",
    "test:api": "npm --workspace=apps/api test",
    "dev:api": "npm --workspace=apps/api dev",
    "dev:web": "npm --workspace=apps/web dev",
    "db:migrate": "npm --workspace=packages/database run migrate",
    "db:seed": "npm --workspace=packages/database run seed"
  }
}
